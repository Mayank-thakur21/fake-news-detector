# ---------------------------------------------------------------------------
# Fake News Detector - environment configuration
# Copy to `.env` and adjust. Every value below shows its default.
# (Comments are on their own lines: inline comments are parsed inconsistently
#  by different .env loaders.)
# ---------------------------------------------------------------------------

# ===== Backend =============================================================
# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
# true => one JSON object per log line (recommended in production)
LOG_JSON=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=*

# Comma-separated API keys sent by clients in the X-API-Key header.
# Leave EMPTY to disable auth (local development only!).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Requests per minute per API key (or per IP when auth is off)
RATE_LIMIT_PER_MINUTE=60
BATCH_RATE_LIMIT_PER_MINUTE=10
BATCH_MAX_ITEMS=25

MODEL_DIR=models
# rf | lr | svm
DEFAULT_MODEL=rf
DB_PATH=storage/predictions.db

MIN_WORDS=5
MAX_TEXT_CHARS=100000

SCRAPER_TIMEOUT=10
SCRAPER_MAX_BYTES=5000000
# Keep false in production: blocks fetching private/internal IPs (SSRF protection)
SCRAPER_ALLOW_PRIVATE_HOSTS=false

# ===== Docker entrypoint ===================================================
# Train models on container start if none are present in MODEL_DIR
AUTO_TRAIN=true

# ===== Frontend ============================================================
API_URL=http://127.0.0.1:8000
# One of API_KEYS (sent as X-API-Key)
API_KEY=
# light | dark
DEFAULT_THEME=light
